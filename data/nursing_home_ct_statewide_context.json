  "policy_reference": {
    "schema_version": "ct-policy-reference-1.0",
    "dataset_type": "ct_nursing_home_staffing_policy_reference",
    "maintained_by": "Hand-maintained reference. Every entry cites its public source. Re-verify on each data refresh.",
    "last_verified": "2026-11-04",
    "rule_timeline": [
      {
        "date": "pre-2022",
        "label": "Older regulatory baseline",
        "detail": "Title 19, Sec. 19-13-D8t(m): 1.90 total nursing and aide hours and 0.64 licensed hours per patient day for chronic and convalescent nursing homes. The same subsection excludes director of nurses time in homes of 61+ beds and assistant director time in homes of 121+ beds from counting toward the minimums.",
        "source_title": "CT regulations, Sec. 19-13-D8t(m)",
        "source_url": "https://portal.ct.gov/-/media/sots/regulations/title_19/013dpdf.pdf?la=en"
      },
      {
        "date": "2021",
        "date_label": "2021",
        "label": "Statute directs a 3-hour standard",
        "detail": "Public Act 21-185 (CGS Sec. 19a-563h) directed DPH to set minimum staffing of three hours of direct care per resident per day by January 1, 2022. DPH said revised regulations would not be in place by that date.",
        "source_title": "CGS chapter 368v, Sec. 19a-563h",
        "source_url": "https://www.cga.ct.gov/2022/sup/chap_368v.htm"
      },
      {
        "date": "2023-03-01",
        "date_label": "March 1, 2023",
        "label": "DPH 3.0 policies take effect",
        "detail": "Former DPH policies: 0.84 hours of nursing care plus 2.16 hours of nurse aide services per resident per day (3.00 total).",
        "source_title": "DPH Blast Fax 2024-3A",
        "source_url": "https://portal.ct.gov/-/media/departments-and-agencies/dph/facility-licensing--investigations/blast-faxes/2024/blast-fax-2024-3a--amendments-to-policies-and-procedures-implementing-30-staffing-revised.pdf"
      },
      {
        "date": "2024-01-05",
        "date_label": "January 5, 2024",
        "label": "Amended DPH policies",
        "detail": "3.0 hours of total nursing and nurse aide care per resident per day, of which 0.84 hours provided by licensed nursing personnel.",
        "source_title": "DPH Blast Fax 2024-3A",
        "source_url": "https://portal.ct.gov/-/media/departments-and-agencies/dph/facility-licensing--investigations/blast-faxes/2024/blast-fax-2024-3a--amendments-to-policies-and-procedures-implementing-30-staffing-revised.pdf"
      },
      {
        "date": "2026-01-27",
        "date_label": "January 27, 2026",
        "label": "Staffing regulation approved",
        "detail": "The Legislative Regulation Review Committee approved DPH's regulation (2024-026A) with technical corrections, 13-0. It sets 3.00 direct-care hours per resident per day, licensed nursing minimums of 0.57 hours (7 a.m. to 9 p.m.) and 0.27 hours (9 p.m. to 7 a.m.), and a registered nurse on duty at all times, and replaces the policies. An earlier version was rejected without prejudice on December 17, 2024.",
        "source_title": "CGA, Regulation 2024-026A (PR2022-032) record",
        "source_url": "https://www.cga.ct.gov/aspx/CGARegulations/CGARegulations.aspx?Yr=2026&Reg=2024-026&Amd=A"
      },
      {
        "date": "2026-02-11",
        "date_label": "February 11, 2026",
        "label": "Staffing regulation takes effect",
        "detail": "Filed with the Secretary of the State on February 5, 2026, the regulation amending Sec. 19-13-D8t took effect February 11, 2026, replacing DPH's staffing policies.",
        "source_title": "CT eRegulations, PR2022-032 final regulation and certification",
        "source_url": "https://eregulations.ct.gov/eRegsPortal/Search/getDocument?guid=%7BB0E34C9C-0000-C116-88C4-C5FFBA05300B%7D"
      }
    ],
