          },
          "data_as_of": {
            "$ref": "#/components/schemas/DataAsOf"
          },
          "links": {
            "type": "object",
            "additionalProperties": true
          },
          "ccn": {
            "type": "string"
          },
          "facility_name": {
            "type": "string"
          },
