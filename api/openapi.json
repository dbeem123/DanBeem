  "components": {
    "schemas": {
      "Report": {
        "title": "CT nursing home report",
        "type": "object",
        "required": [
          "schema_version",
          "report_type",
          "subject",
          "generated_at",
          "data_as_of",
          "executive_summary",
          "findings",
          "metrics",
          "historical_trends",
          "relationships",
          "sources",
          "limitations",
          "missing_data",
          "recommended_follow_up",
          "links"
        ],
        "properties": {
          "schema_version": {
            "const": "reporting-api-1.0"
          },
          "report_type": {
            "enum": [
              "facility-comprehensive",
              "ownership-network",
              "staffing-analysis",
              "financial-transparency",
              "regulatory-history",
              "related-party-screening",
              "management-company-portfolio"
            ]
          },
          "subject": {
            "type": "object",
            "oneOf": [
              {
                "required": [
                  "ccn",
                  "facility_name"
                ],
                "properties": {
                  "ccn": {
                    "type": "string",
                    "pattern": "^[0-9A-Z]{6}$"
                  }
                }
              },
              {
                "required": [
                  "company_id",
                  "company_name"
                ]
              }
            ]
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "data_as_of": {
            "type": "object"
          },
          "executive_summary": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "kind"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "finding_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Finding"
            }
          },
          "metrics": {
            "type": "object"
          },
          "historical_trends": {
            "type": "object"
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "relationship_type"
              ]
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_key",
                "agency",
                "dataset"
              ],
              "properties": {
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "reason"
              ]
            }
          },
          "recommended_follow_up": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "links": {
            "type": "object"
          }
        }
      },
      "Finding": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "severity",
          "statement",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "confirmed_fact",
              "calculated",
              "possible_association",
              "investigative_question"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "attention"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 10
          },
          "formula": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "calculated"
                }
              }
            },
            "then": {
              "required": [
                "formula"
              ]
            }
          }
        ]
      },
      "Evidence": {
        "type": "object",
        "required": [
          "source_key",
          "agency",
          "dataset",
          "url",
          "as_of",
          "record_id",
          "verification",
          "reporting_period"
        ],
        "properties": {
          "verification": {
            "enum": [
              "source_record",
              "source_record_unvalidated",
              "derived",
              "name_match_unverified"
            ]
          },
          "source_key": {
            "type": "string"
          },
          "agency": {
            "type": "string"
          },
          "dataset": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "reporting_period": {
            "type": [
              "string",
              "null"
            ]
          },
          "as_of": {
            "type": "string"
          },
          "record_id": {
            "type": "string"
          },
          "site_file": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "description": "Source record backing a finding. Also carries optional site_file, note."
      },
      "DataAsOf": {
        "type": "object",
        "description": "Map of source key to as-of date or release label.",
        "additionalProperties": {
          "type": "string"
        }
      },
      "Ccn": {
        "type": "string",
        "pattern": "^[0-9A-Z]{6}$",
        "description": "6-character CMS Certification Number, e.g. 075396."
      },
      "Index": {
        "type": "object",
        "description": "Catalog of the API: url_templates, sources, evidence_kinds, counts.",
        "additionalProperties": true
      },
      "FacilityList": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "reporting-api-1.0"
          },
          "endpoint": {
            "type": "string"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "data_as_of": {
            "$ref": "#/components/schemas/DataAsOf"
          },
          "links": {
            "type": "object",
            "additionalProperties": true
          },
          "count": {
            "type": "integer"
          },
          "facilities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ccn": {
                  "type": "string"
                },
                "facility_name": {
                  "type": "string"
                },
                "city": {
                  "type": "string"
                },
                "operating_status": {
                  "type": "string"
                },
                "legal_entity": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "management_current": {
                  "type": "array",
                  "items": {}
                },
                "profile": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        },
        "additionalProperties": true
      },
      "Profile": {
        "type": "object",
        "description": "Facility identity, latest staffing and financial snapshots, inspection summary.",
        "required": [
          "schema_version",
          "endpoint",
          "ccn",
          "facility_name"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "reporting-api-1.0"
          },
          "endpoint": {
            "type": "string"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "data_as_of": {
            "$ref": "#/components/schemas/DataAsOf"
          },
          "links": {
            "type": "object",
            "additionalProperties": true
          },
          "ccn": {
            "type": "string"
          },
          "facility_name": {
            "type": "string"
          },
          "identity": {
            "type": "object",
            "additionalProperties": true
          },
          "ownership_summary": {
            "type": "object",
            "additionalProperties": true
          },
          "staffing_latest": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "financial_latest": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "inspection_summary": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "missing_data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": true
      },
      "Ownership": {
        "type": "object",
        "description": "CMS ownership and control, management companies, administrators of record, DSS-named owners, changes of ownership.",
        "required": [
          "schema_version",
          "endpoint",
